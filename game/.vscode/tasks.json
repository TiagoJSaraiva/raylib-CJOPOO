{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build debug",
        "type": "process",
        "command": "make",
        "args": [
          "game",
          "PLATFORM=PLATFORM_DESKTOP",
          "BUILD_MODE=DEBUG"
        ],
        "windows": {
          "command": "mingw32-make",
          "args": [
            "game",
            "BUILD_MODE=DEBUG"
          ]
        },
        "group": "build",
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "build release",
        "type": "process",
        "command": "make",
        "args": [
          "game",
          "PLATFORM=PLATFORM_DESKTOP"
        ],
        "windows": {
          "command": "mingw32-make",
          "args": [
            "game"
          ]
        },
        "problemMatcher": [
          "$gcc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "detail": "compiler: MinGW-w64 from PATH"
      }
    ]
}
